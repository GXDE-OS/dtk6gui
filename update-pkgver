# 本脚本从debian/changelog中读取版本并且更新PKGBUILD的版本
# This script reads version from debian/changelog and update the version of
# PKGBUILD.
#
# 用法/Usage:
#   ./update-pkgver                 # 从 debian/changelog 读取 / read from debian/changelog
#   ./update-pkgver 6.0.49          # pkgver=6.0.49, pkgrel=1
#   ./update-pkgver 6.0.49-gxde3    # pkgver=6.0.49, pkgrel=3
#   ./update-pkgver -r 2 6.0.49     # 强制 pkgrel / force pkgrel=2

set -euo pipefail

# 引用/Works Cited: https://patorjk.com/software/taag/#p=display&f=Linguaholic+Shadow+3D
echo '  ██████╗██╗     ██╗██████╗  ████████╗           ████╗                     '
echo '██╔═════╝╚═██╗ ██╔═╝██╔═══██╗██╔═════╝         ██╔═══╝  ████╗  ██╗ ████╗   '
echo '██║ ████╗  ╚═██╔═╝  ██║   ██║██████╗         ██████╗  ██╔═══██╗████╔═══╝   '
echo '██║ ╚═██║  ██╔═██╗  ██║   ██║██╔═══╝         ╚═██╔═╝  ██║   ██║██╔═╝       '
echo '╚═██████║██╔═╝ ╚═██╗██████╔═╝████████╗         ██║    ╚═████╔═╝██║         '
echo '  ╚═════╝╚═╝     ╚═╝╚═════╝  ╚═══════╝         ╚═╝      ╚═══╝  ╚═╝         '
echo '                                                                           '
echo '                                                                           '
echo '  ████╗                    ██╗      ██╗      ██╗                           '
echo '██╔═══██╗██╗ ████╗  ██████╗██████╗  ██║      ╚═╝██████╗  ██╗   ██╗██╗   ██╗'
echo '████████║████╔═══╝██╔═════╝██╔═══██╗██║      ██╗██╔═══██╗██║   ██║╚═████╔═╝'
echo '██╔═══██║██╔═╝    ██║      ██║   ██║██║      ██║██║   ██║██║   ██║  ████║  '
echo '██║   ██║██║      ╚═██████╗██║   ██║████████╗██║██║   ██║╚═██████║██╔═══██╗'
echo '╚═╝   ╚═╝╚═╝        ╚═════╝╚═╝   ╚═╝╚═══════╝╚═╝╚═╝   ╚═╝  ╚═════╝╚═╝   ╚═╝'

# 本脚本位于仓库根目录，可以从任意目录调用
# This script lives in the repo root and can be invoked from any directory.
repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
pkgbuild_dir="$repo_dir/arch"
pkgbuild="$pkgbuild_dir/PKGBUILD"
changelog="$repo_dir/debian/changelog"

usage() {
    sed -n '/^# 用法\/Usage:/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

pkgrel=
version=
while (($#)); do
    case "$1" in
        -r|--pkgrel) pkgrel=${2:?missing value for $1}; shift 2 ;;
        -h|--help) usage ;;
        -*) echo "unknown option: $1" >&2; usage 1 ;;
        *) version=$1; shift ;;
    esac
done

if [[ -z $version ]]; then
    # First line of debian/changelog: "dtkcommon (5.7.16-2) unstable; urgency=medium"
    version=$(sed -nE '1s/^[^ ]+ \(([^)]+)\).*/\1/p' "$changelog")
    [[ -n $version ]] || { echo "cannot parse version from $changelog" >&2; exit 1; }
    echo "version from debian/changelog: $version"
fi

# Debian "epoch:upstream-revision" -> Arch pkgver/pkgrel
version=${version#*:}
if [[ $version == *-* ]]; then
    upstream=${version%-*}
    revision=${version##*-}
else
    upstream=$version
    revision=
fi

# pkgver must not contain ':', '/', '-' or whitespace
pkgver=$(tr '~+:/ -' '......' <<<"$upstream")

if [[ -z $pkgrel ]]; then
    # 取修订号中的第一个数字 / Take the first number of the Debian revision:
    # "2" -> 2, "2deepin1" -> 2, "gxde4" -> 4
    pkgrel=$(grep -oE '[0-9]+' <<<"$revision" | head -n1 || true)
    pkgrel=${pkgrel:-1}
fi

[[ $pkgver =~ ^[0-9][0-9A-Za-z._]*$ ]] || { echo "invalid pkgver: $pkgver" >&2; exit 1; }
[[ $pkgrel =~ ^[1-9][0-9]*(\.[1-9][0-9]*)?$ ]] || { echo "invalid pkgrel: $pkgrel" >&2; exit 1; }

old=$(grep -E '^pkg(ver|rel)=' "$pkgbuild" | paste -sd' ')
sed -i -E "s/^pkgver=.*/pkgver=$pkgver/; s/^pkgrel=.*/pkgrel=$pkgrel/" "$pkgbuild"
echo "$old -> pkgver=$pkgver pkgrel=$pkgrel"

bash -n "$pkgbuild"
if command -v makepkg >/dev/null; then
    (cd "$pkgbuild_dir" && makepkg --printsrcinfo >/dev/null)
    echo "PKGBUILD OK"
fi
